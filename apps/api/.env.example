# Local API configuration. Copy to .env; never commit the populated file.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Matches the `db` service when developing locally with Docker Compose.
DATABASE_URL=postgresql://projectpilot:projectpilot@localhost:5432/projectpilot?schema=public
JWT_SECRET=replace-with-a-64-character-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-a-different-64-character-random-refresh-token-secret
LOG_LEVEL=info
# Optional: increases GitHub search rate limits. Create a fine-grained token with public repository read access.
GITHUB_TOKEN=
